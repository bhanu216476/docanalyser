# .env.example — Copy to .env and fill in real values.
# NEVER commit the .env file or real secret values.
# This file is safe to commit (contains only placeholders).

# -------------------------------------------------------
# PostgreSQL / Database
# -------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docanalyser
DB_USERNAME=postgres
DB_PASSWORD=

# Docker Compose PostgreSQL Variables
POSTGRES_DB=docanalyser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# -------------------------------------------------------
# Spring Boot JWT
# -------------------------------------------------------
# Minimum 32 characters; use a random 64-char string in production
JWT_SECRET=
# Token lifetime in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# -------------------------------------------------------
# Python RAG Service
# -------------------------------------------------------
RAG_SERVICE_URL=http://localhost:8000
RAG_HOST=0.0.0.0
RAG_PORT=8000
ENVIRONMENT=development

# -------------------------------------------------------
# n8n Ingestion Security
# -------------------------------------------------------
# Random secret token shared between n8n and Spring Boot
N8N_INGESTION_TOKEN=

# -------------------------------------------------------
# OpenAI
# -------------------------------------------------------
OPENAI_API_KEY=

# -------------------------------------------------------
# Embedding Service
# -------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=20
EMBEDDING_MAX_TOKENS=8191
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BASE_DELAY=1.0

# -------------------------------------------------------
# Qdrant Vector Store
# -------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT=10.0
QDRANT_BATCH_SIZE=64
QDRANT_MAX_RETRIES=3
QDRANT_RETRY_BASE_DELAY=0.5

# -------------------------------------------------------
# Google OAuth2 (used by n8n credential — not stored here)
# -------------------------------------------------------
# These are referenced by n8n's credential system.
# Do NOT paste actual values here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------------------------------------------------------
# Redis Cache & State
# -------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_DOCUMENT_TTL_SECONDS=300
SESSION_STATE_TTL_SECONDS=1800
JOB_STATUS_TTL_SECONDS=86400
