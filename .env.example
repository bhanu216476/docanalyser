# .env.example — Copy to .env and fill in real values.
# NEVER commit the .env file or real secret values.
# This file is safe to commit (contains only placeholders).

# ==============================================================================
# Platform Ports & Profiles
# ==============================================================================
SPRING_PROFILES_ACTIVE=docker
FRONTEND_PORT=5173
BACKEND_PORT=8080
RAG_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
N8N_PORT=5678

# ==============================================================================
# PostgreSQL / Relational Database
# ==============================================================================
# Internal container network address is 'postgres', host machine address is 'localhost'
DB_HOST=postgres
DB_PORT=5432
DB_NAME=docanalyser
DB_USERNAME=postgres
DB_PASSWORD=postgres

# PostgreSQL Container Variables
POSTGRES_DB=docanalyser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ==============================================================================
# Redis Cache & State Store
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_DOCUMENT_TTL_SECONDS=300
SESSION_STATE_TTL_SECONDS=1800
JOB_STATUS_TTL_SECONDS=86400

# ==============================================================================
# Qdrant Vector Store
# ==============================================================================
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT=10.0
QDRANT_BATCH_SIZE=64
QDRANT_MAX_RETRIES=3
QDRANT_RETRY_BASE_DELAY=0.5

# ==============================================================================
# Spring Boot API & Security
# ==============================================================================
RAG_SERVICE_URL=http://rag-service:8000
# Minimum 32 characters; generate a secure random string in production
JWT_SECRET=changeme-production-secure-key-docanalyser-min-32-chars
JWT_EXPIRATION=86400000
# Shared internal token between n8n and Spring Boot for webhook ingestion
N8N_INGESTION_TOKEN=docanalyser-n8n-internal-token-secret

# ==============================================================================
# Python RAG Service (FastAPI)
# ==============================================================================
RAG_HOST=0.0.0.0
ENVIRONMENT=production
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=20
EMBEDDING_MAX_TOKENS=8191
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BASE_DELAY=1.0

# ==============================================================================
# Frontend (React + Vite)
# ==============================================================================
# Note: Browser requests must connect to the host-accessible URL, not container DNS
VITE_API_URL=http://localhost:8080
VITE_RAG_URL=http://localhost:8000

# ==============================================================================
# n8n Workflow Automation
# ==============================================================================
N8N_ENCRYPTION_KEY=n8n-docanalyser-secret-encryption-key-32chars
N8N_HOST=localhost
N8N_PROTOCOL=http
TIMEZONE=UTC

# ==============================================================================
# Google OAuth2 (referenced by n8n credentials for Google Drive)
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# Observability (OpenTelemetry, Prometheus, Grafana, Structured Logging)
# ==============================================================================
# OpenTelemetry Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_SAMPLER_ARG=1.0
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
SERVICE_NAME=rag-service

# Logging Levels
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# Observability Service Ports
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Grafana Security
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=changeme
